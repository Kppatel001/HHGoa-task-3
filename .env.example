# =====================================================================
# FaceProof — example environment configuration
# Copy to backend/.env (and contracts/.env where noted) and fill in.
# NEVER commit the real .env file. Secrets stay local.
# =====================================================================

# ---- App ----
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed CORS origins for the frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Where uploaded images are temporarily written (auto-cleaned)
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=10
# Delete uploaded images after the scan session completes
DELETE_UPLOADS_AFTER_SESSION=true
# Persist raw 512-d embeddings to DB (default false for privacy)
STORE_EMBEDDINGS=false

# ---- Database ----
# SQLite by default; swap for a postgresql+psycopg:// URL to use Postgres
DATABASE_URL=sqlite:///./faceproof.db

# ---- Face recognition ----
# InsightFace model pack; buffalo_l is 512-d and downloads on first run
FACE_MODEL=buffalo_l
# Detection provider for onnxruntime: CPUExecutionProvider or CUDAExecutionProvider
FACE_EXEC_PROVIDER=CPUExecutionProvider
# Cosine-similarity threshold above which a candidate is a "potential match"
FACE_MATCH_THRESHOLD=0.35
# Minimum detector confidence to accept a face
FACE_DET_MIN_CONFIDENCE=0.5
# Minimum face pixel size before we warn about low resolution
FACE_MIN_PIXELS=60

# ---- Search provider ----
# Options: google_cse | demo
# 'google_cse' performs a genuine Google Programmable Search query.
# 'demo' uses the clearly-labeled local demo dataset (no key needed).
SEARCH_PROVIDER=demo
# Google Programmable Search Engine (Custom Search JSON API)
# Get a key: https://developers.google.com/custom-search/v1/overview
# Create an engine (cx): https://programmablesearchengine.google.com/
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
# Max candidate results to pull from the provider
SEARCH_MAX_RESULTS=8
# Per-request timeout (seconds) for external HTTP calls
SEARCH_HTTP_TIMEOUT=15
# Max bytes to download for a candidate image (SSRF / zip-bomb guard)
CANDIDATE_MAX_IMAGE_BYTES=8000000

# ---- Blockchain ----
# "rpc"    -> external EVM node (Hardhat / testnet), configured below (Docker path)
# "memory" -> real EVM in-process (eth-tester); no node or Node.js needed (no-Docker path)
BLOCKCHAIN_MODE=rpc

# ---- Blockchain RPC (used when BLOCKCHAIN_MODE=rpc; local Hardhat by default) ----
# When you run `docker compose up`, the hardhat node is reachable at
# http://hardhat:8545 inside the compose network, or http://127.0.0.1:8545 locally.
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
# Hardhat's first well-known dev account private key (LOCAL DEV ONLY — public key).
# Replace with a funded test key for a public testnet. NEVER use a real key.
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Filled in automatically by the deploy script (contracts/deployments/<chainId>.json).
# You can also hardcode it here to override.
CONTRACT_ADDRESS=
# Explorer base URL for building "View Transaction" links.
# Local chain has no explorer; leave blank. For Sepolia use https://sepolia.etherscan.io
BLOCK_EXPLORER_URL=

# ---- Logging ----
LOG_LEVEL=INFO
