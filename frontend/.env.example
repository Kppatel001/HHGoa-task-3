# Frontend env. In dev, /api is proxied to the backend (see vite.config.ts),
# so you usually don't need to set anything.

# Point the dev proxy at a non-default backend:
# VITE_API_TARGET=http://127.0.0.1:8000

# Call an absolute backend URL instead of the proxy (e.g. in production):
# VITE_API_BASE_URL=https://your-backend.example.com/api
